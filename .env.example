# Copie para .env (a raiz do projeto) para sobrescrever o buildKiosk/config.json
# em tempo de execucao. Todas as variaveis sao opcionais: sem elas vale o que
# esta no config.json do build.

# URL do homeserver Matrix
KIOSK_CND_HOME_SERVER_URL=https://matrix.meuservidor.com.br
# Dominio Matrix (server_name), nao a URL
KIOSK_CND_HOME_SERVER_NAME=meuservidor.com.br
# Nome exibido do servico
KIOSK_CND_BRAND_NAME=Servico Teste
# Logo da tela de login
KIOSK_CND_BRAND_IMG_URL=
# light | dark
KIOSK_CND_TEMA=light
